# Groq API key (free tier) — get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxx

# Path to your Google OAuth client secret JSON (downloaded from Google Cloud Console)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# Where the OAuth token gets cached after first login (auto-created, don't commit this)
YOUTUBE_TOKEN_FILE=token.json

# YouTube Data API key (separate from the OAuth client above - this one only
# ever reads public data) — needed for the Discover and Filler tabs.
# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API key
YOUTUBE_API_KEY=

# yt-dlp "Sign in to confirm you're not a bot" fix. Either drop a Netscape-format
# cookies export at youtube_cookies.txt (used automatically), or set one of these.
# Use a throwaway Google account, not your channel's.
YT_COOKIES_FILE=
YT_COOKIES_BROWSER=

# ---- Posting to other platforms (all optional - see SOCIAL_SETUP.md) ----
# Facebook Reels + Instagram Reels (one Meta app, one Page). Run `python social_auth.py meta`
# and it fills in the three FACEBOOK_/INSTAGRAM_ lines for you.
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# TikTok (then run `python social_auth.py tiktok` once). The redirect address must be https
# and registered in your TikTok app's Login Kit settings.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=


# Optional: use your Claude subscription (through Claude Code, no API key) as the script writer. 1 = on.
USE_CLAUDE_CODE=0
# Optional: free OpenRouter models as a last-resort writer (slow and unreliable on long jobs).
OPENROUTER_API_KEY=
