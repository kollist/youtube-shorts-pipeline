# Python
__pycache__/
*.pyc
venv/
.venv/

# OS
.DS_Store

# Secrets / OAuth (never commit these)
.env
client_secret.json
token.json

# Generated/data dirs (re-creatable by running the pipeline)
input/
output/
transcripts/
clips/
.groq_usage.json
upload_log.jsonl

# User-supplied gameplay/filler footage for the split-screen clip layout -
# yours, not something the pipeline generates or this repo should ship.
filler/

# Claude Code local-only settings
.claude/settings.local.json

# Story-to-video: the local image models (~25 GB) and everything generated per episode.
# Tracked: each series.json, each episode's story.json, credit.txt and posted.json (the scripts + licence credits).
# Ignored: pictures, videos, audio and build folders (all re-creatable).
models/
stories/**/images/
stories/**/build/
stories/**/build_horror/
stories/**/motion/
stories/**/*.mp4
stories/**/*.mp3
stories/**/*.wav
stories/**/*.m4a
stories/**/*.png

# Social posting: logins that refresh, and the log of non-YouTube posts
social_tokens.json
social_log.jsonl
venv-mlx/

# YouTube login cookies for yt-dlp (grant access to your account - never commit)
youtube_cookies.txt

# Generated test videos and retired outputs, caches, backups
archive/outputs/
data/caption_history.json
*.bak
.DS_Store

# Pixabay sounds: free to use in videos but not to redistribute
assets/sfx/pixabay_*
data/auto_*
data/scp_queue.json
data/auto.lock
data/tiktok_caption.txt
branding/*_raw.png
exports/
legal_site/
